  {
    "id": "fn_telegram",
    "type": "function",
    "z": "tab_delivery",
    "name": "Build Telegram request",
    "func": "// Exactly ONE Telegram message in the whole delivery: triggered by the Pi's ready_for_pickup event.\nconst token  = env.get(\"TELEGRAM_BOT_TOKEN\");\nconst chatId = env.get(\"TELEGRAM_CHAT_ID\");\nif (!token || !chatId) {\n    node.error(\"Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in this tab's Environment Variables\");\n    return null;\n}\nmsg.url = \"https://api.telegram.org/bot\" + token + \"/sendMessage\";\nmsg.headers = { \"content-type\": \"application/json\" };\nmsg.payload = { chat_id: chatId, text: \"الشحنة جاهزة للاستلام\" };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 200,
    "wires": [
      [
        "http_telegram"
      ]
    ]
  },
