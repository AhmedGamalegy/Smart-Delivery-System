  {
    "id": "fn_log",
    "type": "function",
    "z": "tab_delivery",
    "name": "Add to event log",
    "func": "// Keep the last 20 events and turn them into one text block for the Dashboard.\nconst p = msg.payload;\nconst when = String(p.timestamp || \"\").replace(\"T\", \" \");\nlet line = when + \"   \" + p.event;\nif (p.reason)     { line += \"   (\" + p.reason + \")\"; }\nif (p.card)       { line += \"   card=\" + p.card; }\nif (p.issue_type) { line += \"   [\" + p.issue_type + \"]\"; }\nlet log = flow.get(\"event_log\") || [];\nlog.unshift(line);\nlog = log.slice(0, 20);\nflow.set(\"event_log\", log);\nreturn { payload: log.join(\"\\n\") };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 100,
    "wires": [
      [
        "ui_log"
      ]
    ]
  },
