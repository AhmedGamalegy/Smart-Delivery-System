        "email_out"
      ]
    ]
  },
  {
    "id": "fn_mail_issue",
    "type": "function",
    "z": "tab_delivery",
    "name": "Build 'issue' email",
    "func": "const p = msg.payload;\nconst to = env.get(\"MANAGER_EMAIL\");\nif (!to) { node.error(\"Set MANAGER_EMAIL in this tab's Environment Variables\"); return null; }\nconst hasLoc = (p.latitude !== null && p.latitude !== undefined && p.longitude !== null && p.longitude !== undefined);\nreturn {\n    to: to,\n    topic: \"Issue reported - shipment \" + p.shipment_id,\n    payload: \"Shipment ID: \" + p.shipment_id + \"\\n\" +\n             \"Issue type: \" + p.issue_type + \"\\n\" +\n             \"Details: \" + (p.details || \"-\") + \"\\n\" +\n             \"Time: \" + p.timestamp + \"\\n\" +\n             \"Last known location: \" + (hasLoc ? p.latitude + \", \" + p.longitude : \"no location received yet\") + \"\\n\" +\n             \"Last location update time: \" + (p.last_location_timestamp || \"n/a\") + \"\\n\"\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
