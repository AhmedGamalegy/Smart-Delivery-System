  {
    "id": "fn_loc",
    "type": "function",
    "z": "tab_delivery",
    "name": "Split location for widgets",
    "func": "// Only formatting/routing. NO geofence here - the Raspberry Pi does that.\nconst p = msg.payload;\nif (!p || p.latitude === undefined || p.longitude === undefined) { return null; }\nconst when = String(p.timestamp);\nreturn [\n    { payload: String(p.latitude) },\n    { payload: String(p.longitude) },\n    { payload: when.replace(\"T\", \" \") },\n    { payload: \"Source: OwnTracks (courier phone) via HiveMQ -> Raspberry Pi.  Last fix: \" + when.replace(\"T\", \" \") },\n    { payload: { name: \"Courier\", lat: p.latitude, lon: p.longitude, icon: \"car\", iconColor: \"red\" } }\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
