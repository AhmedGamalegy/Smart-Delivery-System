  {
    "id": "fn_state",
    "type": "function",
    "z": "tab_delivery",
    "name": "Split state for widgets",
    "func": "// Only formatting/routing. The Raspberry Pi decided the state - we just display it.\nconst p = msg.payload;\nif (!p || !p.state) { return null; }\nconst canConfirm = (p.state === \"CUSTOMER_VERIFIED\");\nreturn [\n    { payload: p.shipment_id },\n    { payload: p.state },\n    { payload: p.customer_verified ? \"Yes\" : \"No\" },\n    { enabled: canConfirm }          // enables / disables the Confirm Delivery button (the Pi still validates)\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
