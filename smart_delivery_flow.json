  {
    "id": "fn_dedupe",
    "type": "function",
    "z": "tab_delivery",
    "name": "Drop duplicate events",
    "func": "// Simple extra protection: same event + same timestamp = same message delivered twice.\n// (The Raspberry Pi is still the real source of truth for duplicates.)\nconst p = msg.payload;\nif (!p || typeof p !== \"object\" || !p.event) { return null; }\nconst key = p.event + \"|\" + (p.timestamp || \"\");\nlet seen = flow.get(\"seen_events\") || [];\nif (seen.includes(key)) {\n    node.status({fill: \"yellow\", shape: \"ring\", text: \"duplicate dropped: \" + p.event});\n    return null;\n}\nseen.push(key);\nflow.set(\"seen_events\", seen.slice(-50));\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 100,
    "wires": [
      [
        "sw_event",
        "fn_log",
        "dbg_events"
      ]
    ]
  },
  {
    "id": "dbg_events",
    "type": "debug",
    "z": "tab_delivery",
    "name": "All events (debug)",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 590,
