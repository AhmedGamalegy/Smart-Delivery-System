  {
    "id": "fn_report",
    "type": "function",
    "z": "tab_delivery",
    "name": "Build issue_report command",
    "func": "// Only sends a command. The Raspberry Pi records the real issue.\nconst type = flow.get(\"issue_type\");\nif (!type) {\n    node.status({fill: \"red\", shape: \"ring\", text: \"no issue type\"});\n    return [null, { payload: \"Choose an Issue Type first, then press Report Issue.\" }];\n}\nconst id = env.get(\"SHIPMENT_ID\");\nconst cmd = {\n    command: \"issue_report\",\n    shipment_id: id,\n    issue_type: type,\n    details: flow.get(\"issue_details\") || \"\",\n    timestamp: new Date().toISOString()\n};\nnode.status({fill: \"green\", shape: \"dot\", text: \"command sent\"});\nreturn [\n    { topic: \"delivery/\" + id + \"/commands\", payload: cmd },\n    { payload: \"Sent issue_report @ \" + cmd.timestamp + \" - the Raspberry Pi will record it (watch the Event log).\" }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 1320,
