  {
    "id": "fn_nfc_text",
    "type": "function",
    "z": "tab_delivery",
    "name": "Format last NFC event",
    "func": "const p = msg.payload;\nlet text;\nif (p.event === \"picked_up\")              { text = \"Courier card accepted -> PICKED_UP\"; }\nelse if (p.event === \"customer_verified\") { text = \"Customer card accepted -> CUSTOMER_VERIFIED\"; }\nelse { text = \"Card rejected (\" + (p.reason || \"unknown\") + \", card: \" + (p.card || \"?\") + \")\"; }\nreturn { payload: text + \"   @ \" + String(p.timestamp).replace(\"T\", \" \") };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
