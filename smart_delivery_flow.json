  {
    "id": "fn_mail_delivered",
    "type": "function",
    "z": "tab_delivery",
    "name": "Build 'delivered' email",
    "func": "const p = msg.payload;\nconst to = env.get(\"MANAGER_EMAIL\");\nif (!to) { node.error(\"Set MANAGER_EMAIL in this tab's Environment Variables\"); return null; }\nreturn {\n    to: to,\n    topic: \"Delivery confirmed - \" + p.shipment_id,\n    payload: \"Shipment \" + p.shipment_id + \" was delivered.\\n\" +\n             \"Delivery confirmed by the Raspberry Pi at: \" + p.timestamp + \"\\n\"\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 260,
    "wires": [
